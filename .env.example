# ============================================================================
# re-toolbox configuration — copy to .env and customize
# ============================================================================

# --- Gateway ---
# Enable StreamableHTTP transport (set to 1 for HTTP, 0 for stdio-only)
ENABLE_GATEWAY_HTTP=1
GATEWAY_HTTP_PORT=3100
GATEWAY_HTTP_HOST=0.0.0.0

# --- Ghidra headless MCP ---
GHIDRA_MCP_PORT=8089
GHIDRA_MCP_AUTH_TOKEN=re-toolbox-dev-secret
GHIDRA_MCP_URL=http://127.0.0.1:8089
GHIDRA_INSTALL_DIR=/opt/tools/ghidra
GHIDRA_PROJECTS_DIR=/home/ctf/ghidra-projects

# --- Build flags (0=skip, 1=include) ---
BUILD_ANGR=1
BUILD_FUZZING=0
BUILD_ANDROID=0

# --- Fuzzing ---
FUZZING_DIR=/opt/tools/fuzzing

# --- Docker ---
COMPOSE_PROJECT_NAME=reverse-mcp
